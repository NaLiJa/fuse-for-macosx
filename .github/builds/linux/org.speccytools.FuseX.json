{
  "app-id": "org.speccytools.FuseX",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "fuse",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=home"
  ],
  "modules": [
    {
      "name": "libspectrum",
      "buildsystem": "simple",
      "build-commands": [
        "./autogen.sh",
        "./configure --prefix=/app --disable-shared --without-libgcrypt --without-libaudiofile --without-fake-glib",
        "make -j$FLATPAK_BUILDER_N_JOBS",
        "make install"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../../3rdparty/libspectrum"
        }
      ]
    },
    {
      "name": "fusex",
      "buildsystem": "simple",
      "build-commands": [
        "./autogen.sh",
        "make -C 3rdparty libssh2 MBEDTLS_BUILD_TARGET=lib MBEDTLS_MAKE_ARGS= MBEDTLS_CFLAGS=-fPIC LIBSSH2_CMAKE_ARGS=-DCMAKE_INSTALL_LIBDIR:PATH=lib",
        "test -f 3rdparty/dist/lib/libssh2.a && test -f 3rdparty/dist/include/libssh2.h",
        "./configure --prefix=/app --without-sdl --enable-sockets --enable-desktop-integration --with-desktop-dir=/app/share",
        "make -j$FLATPAK_BUILDER_N_JOBS",
        "make check",
        "make install"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../../"
        }
      ]
    }
  ]
}
